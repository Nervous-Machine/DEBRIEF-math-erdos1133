repo: theorem erdos_1133 : ∀ C > (0 : ℝ), ∃ ε > (0 : ℝ), ∀ᶠ n : ℕ in atTop, ∀ x : Fin n → Icc (-1 : ℝ) 1, ∃ y : Fin n → Icc (-1 : ℝ) 1, ∀ P : Polynomial ℝ, (P.natDegree : ℝ) < (1+ε)*(n : ℝ) → ((Finset.univ.filter (fun i => P.eval (x i : ℝ)=(y i : ℝ))).card : ℝ) ≥ (1-ε)*(n : ℝ) → ∃ z ∈ Icc (-1 : ℝ) 1, |P.eval z| > C 
fc:   theorem erdos_1133 : ∀ C > (0 : ℝ), ∃ ε > (0 : ℝ), ∀ᶠ n : ℕ in atTop, ∀ x : Fin n → Icc (-1 : ℝ) 1, ∃ y : Fin n → Icc (-1 : ℝ) 1, ∀ P : Polynomial ℝ, (P.natDegree : ℝ) < (1 + ε) * (n : ℝ) → ((Finset.univ.filter (fun i ↦ P.eval (x i : ℝ) = (y i : ℝ))).card : ℝ) ≥ (1 - ε) * (n : ℝ) → ∃ z ∈ Icc (-1 : ℝ) 1, |P.eval z| > C 
